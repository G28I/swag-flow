// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Thread {
  id             String    @id @default(uuid())
  title          String
  userId         String    // Clerk user ID or anonymous ownership token (anon_<token>)
  parentThreadId String?   // Pointer to original thread if this is a branched/forked thread
  parentThread   Thread?   @relation("ThreadForks", fields: [parentThreadId], references: [id], onDelete: SetNull)
  forks          Thread[]  @relation("ThreadForks")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  messages       Message[]
  votes          Vote[]

  @@index([userId])
  @@index([parentThreadId])
}

model Message {
  id               String    @id @default(uuid())
  role             String    // "user" | "assistant" | "system"
  content          String    @db.Text
  model            String?   // Model identifier (null for user messages)
  actualModel      String?   // Realized model if fallback occurred
  threadId         String
  thread           Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parentId         String?   // Pointer to preceding message in thread graph
  parent           Message?  @relation("MessageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Message[] @relation("MessageHierarchy")

  // Hyperparameters
  systemPrompt     String?   @db.Text
  temperature      Float?
  topP             Float?
  maxTokens        Int?

  // Performance Metrics
  latency          Float?    // Total response generation time in seconds
  ttft             Float?    // Time to First Token in seconds
  tokensPerSec     Float?    // Throughput in tokens/second
  tokenCount       Int?      // Total generation output tokens

  // Token Details
  promptTokens     Int?
  completionTokens Int?
  reasoningTokens  Int?
  cachedTokens     Int?

  // Cost Insights
  cost             Float?    // Legacy cost alias
  costUsd          Float?    // Calculated cost in USD
  costSource       String?   // "official" | "openrouter_default" | "fallback"

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  promptVotes      Vote[]    @relation("PromptVotes")

  @@index([threadId])
  @@index([parentId])
  @@index([role])
  @@index([model])
}

model Vote {
  id             String   @id @default(uuid())
  userId         String   // Clerk user ID or anonymous ownership token who voted
  threadId       String
  thread         Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  promptId       String   // The user message ID that triggered this turn
  prompt         Message  @relation("PromptVotes", fields: [promptId], references: [id], onDelete: Cascade)
  votedMessageId String?  // The winning assistant message ID (null if tie/skip)
  votedModel     String?  // The winning model identifier (null if tie/skip)
  models         String[] // All models that participated in this turn
  createdAt      DateTime @default(now())

  @@unique([userId, promptId])
  @@index([threadId])
  @@index([promptId])
  @@index([votedModel])
}
